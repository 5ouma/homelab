local.file "hostname" {
  filename = "/etc/hostname"
}

prometheus.exporter.unix "node" {
  rootfs_path = "/rootfs"
  sysfs_path  = "/sys"
  procfs_path = "/proc"

  disable_collectors = ["btrfs", "xfs", "zfs", "ipvs", "infiniband"]
  enable_collectors  = ["meminfo", "processes", "hwmon", "systemd"]

  filesystem {
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
  }
}

prometheus.exporter.process "procs" {
  matcher {
    name    = "{{.Comm}}"
    cmdline = [".+"]
  }

  track_children = false
  track_threads  = false
}

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }

  rule {
    target_label = "instance"
    replacement  = local.file.hostname.content
  }
}

discovery.relabel "procs" {
  targets = prometheus.exporter.process.procs.targets

  rule {
    target_label = "job"
    replacement  = "processes"
  }

  rule {
    target_label = "instance"
    replacement  = local.file.hostname.content
  }
}

prometheus.scrape "node" {
  targets         = discovery.relabel.node.output
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "procs" {
  targets         = discovery.relabel.procs.output
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "smartctl" {
  targets = [{
    __address__ = "localhost:9633",
    job         = "smartctl",
    instance    = local.file.hostname.content,
  }]

  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "cadvisor" {
  targets = [{
    __address__ = "localhost:8080",
    job         = "cadvisor",
    instance    = local.file.hostname.content,
  }]

  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "speedtest_tracker" {
  targets = [{
    __address__ = "localhost:9080",
    job         = "speedtest-tracker",
    instance    = local.file.hostname.content,
  }]

  metrics_path    = "/prometheus"
  scrape_interval = "600s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "keep"
    regex         = "container_(cpu|memory|network|fs)_.*|container_health_state|machine_.*"
  }

  rule {
    source_labels = ["name"]
    action        = "drop"
    regex         = "^$"
  }

  rule {
    source_labels = ["id"]
    action        = "keep"
    regex         = ".+\\.scope"
  }

  rule {
    action = "labelkeep"
    regex  = "__name__|job|instance|name|id|image|container_label_com_docker_compose_service|container_label_com_docker_compose_project"
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = env("PROMETHEUS_URL")

    basic_auth {
      username = env("PROMETHEUS_USERNAME")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "emerg|alert|crit|err"
    target_label  = "detected_level"
    replacement   = "error"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "warning"
    target_label  = "detected_level"
    replacement   = "warn"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "notice|info"
    target_label  = "detected_level"
    replacement   = "info"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    regex         = "debug"
    target_label  = "detected_level"
    replacement   = "debug"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }
}

loki.source.journal "system" {
  path          = "/var/log/journal"
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.cloud.receiver]

  labels = {
    job      = "systemd-journal",
    instance = local.file.hostname.content,
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_stack"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "instance"
    replacement  = local.file.hostname.content
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.docker_level.receiver]
}

loki.process "docker_level" {
  stage.json {
    expressions = {
      detected_level = "level",
    }
  }

  stage.labels {
    values = {
      detected_level = "detected_level",
    }
  }

  stage.match {
    selector = `{job="docker", detected_level=""} |~ "(?i)\\b(error|err|critical|crit|fatal|ftl|panic|pnc)\\b"`

    stage.static_labels {
      values = {detected_level = "error"}
    }
  }

  stage.match {
    selector = `{job="docker", detected_level=""} |~ "(?i)\\b(warn|warning|wrn)\\b"`

    stage.static_labels {
      values = {detected_level = "warn"}
    }
  }

  stage.match {
    selector = `{job="docker", detected_level=""} |~ "(?i)\\b(info|inf|notice|log|done|statement|detail|hint)\\b"`

    stage.static_labels {
      values = {detected_level = "info"}
    }
  }

  stage.match {
    selector = `{job="docker", detected_level=""} |~ "(?i)\\b(debug|dbg|trace|trc|verbose|verb)\\b"`

    stage.static_labels {
      values = {detected_level = "debug"}
    }
  }

  stage.match {
    selector = `{job="docker", detected_level=""}`

    stage.static_labels {
      values = {detected_level = "info"}
    }
  }

  forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
  endpoint {
    url = env("LOKI_URL")

    basic_auth {
      username = env("LOKI_USERNAME")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
